# Local API
API_HOST=0.0.0.0
API_PORT=3000
NODE_ENV=development

# Browser origins allowed to call the API.
# Development already allows Expo web (8081), Expo classic (19006), and the
# static preview server (4173). In production, only this list is used.
CORS_ORIGINS=

# Expo web/native client — public values only
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Set to true only to browse in-repo fixtures instead of the API.
EXPO_PUBLIC_USE_CATALOGUE_FIXTURES=

# Phase 3 sample player. Leave blank to use the bundled local clip.
# Only relative paths, file/asset URIs, or http(s)://localhost are allowed.
EXPO_PUBLIC_SAMPLE_VIDEO_URI=
EXPO_PUBLIC_SAMPLE_POSTER_URI=

# PostgreSQL (Phase 4) — local Docker Compose placeholder only.
# Never commit real credentials. Copy this file to .env for local use.
DATABASE_URL=postgresql://daiva:daiva@127.0.0.1:5432/daiva

# Amazon Cognito (Phase 7)
# Production/API verification uses AUTH_MODE=cognito and verifies access tokens.
# Local/CI default is AUTH_MODE=test (HMAC test JWTs). Never enable test mode in production.
AUTH_MODE=test
AUTH_TEST_ISSUER=http://127.0.0.1/daiva-test
AUTH_TEST_CLIENT_ID=daiva-test-client
AUTH_TEST_SECRET=replace-with-a-long-local-only-hmac-secret
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=
COGNITO_DOMAIN=

# Expo public auth settings — never put a Cognito client secret here.
EXPO_PUBLIC_AUTH_MODE=test
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:8081/sign-in

# Phase 8 admin allowlist — comma-separated identity subjects. Never trust a client role.
# Local test mode defaults to dev:admin when this is empty. Production must set it explicitly.
ADMIN_SUBJECTS=dev:admin

# Media storage (Phase 9)
AWS_REGION=
MEDIA_SOURCE_BUCKET=
MEDIA_OUTPUT_BUCKET=
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=
CDN_DOMAIN=
