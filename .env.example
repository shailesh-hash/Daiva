# Local API
API_HOST=0.0.0.0
API_PORT=3000
NODE_ENV=development

# Browser origins allowed to call the API.
# Development already allows Expo web (8081), Expo classic (19006), and the
# static preview server (4173). In production, only this list is used.
CORS_ORIGINS=

# Expo web/native client — public values only
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# PostgreSQL (Phase 4) — never commit real credentials
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/daiva

# Amazon Cognito (Phase 7)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=

# Media storage (Phase 9)
AWS_REGION=
MEDIA_SOURCE_BUCKET=
MEDIA_OUTPUT_BUCKET=
CDN_DOMAIN=
